# ─────────────────────────────────────────────────────────────────────────────
# Notch environment
#
# Copy to web/.env.local and fill in. NEXT_PUBLIC_* values are compiled into
# the browser bundle and are PUBLIC. Everything else is server-only and must
# never carry that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── GenLayer (public) ────────────────────────────────────────────────────────
# The deployed Notch contract. Empty until Phase 2; the app runs read-only and
# says so wherever a ruling would otherwise appear.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# ── x402 (public) ────────────────────────────────────────────────────────────
# Testnet only. Notch holds live payment authorizations, and pointing that at
# mainnet before the settlement path is tested and reviewed would risk other
# people's money to make a demo look better.
NEXT_PUBLIC_X402_NETWORK=base-sepolia
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:3000/api/facilitator

# ── Server only — never prefix these with NEXT_PUBLIC_ ───────────────────────

# Signs the settlement transaction when a ruling releases a held payment.
# Absent until Phase 3. While it is empty the facilitator holds and reports
# that it has not settled, rather than pretending it has.
SETTLEMENT_PRIVATE_KEY=

# HMAC key for session cookies. 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server-side RPC for the read proxy.
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# ── Demo seller (dev only) ───────────────────────────────────────────────────
# The bonded wallet that signs delivery receipts for the demo endpoint. The
# E2E script generates and manages these; set them manually only if you are
# running your own seller.
NOTCH_DEMO_SELLER=
NOTCH_DEMO_SELLER_PRIVATE_KEY=

# Challenge window override (seconds; contract minimum 60). The E2E uses 60.
NEXT_PUBLIC_NOTCH_WINDOW_SECONDS=600

# ── Rail (server only) ───────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Operator writes from the service (record_payment / mark_settled). Without
# it, the reconciler reports honest dry runs.
OPERATOR_PRIVATE_KEY=
